{
  "manifest_version": 3,
  "name": "TrueOrigin",
  "version": "0.1.0",
  "description": "Checks images for provenance signals (C2PA Content Credentials) to help answer whether content is AI-generated.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
